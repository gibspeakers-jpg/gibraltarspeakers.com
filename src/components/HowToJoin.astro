---
import { links, meeting } from "../data/site";
---

<section id="how-to-join" class="section bg-maroon text-white">
  <div class="container mx-auto max-w-5xl">
    <div class="max-w-2xl">
      <p class="section-eyebrow text-happy">How to join</p>
      <h2 class="section-heading text-white">Two small steps.</h2>
      <p class="mt-4 text-lg text-slate-100">
        No forms to print. No hoops to jump through. No commitment before your first visit.
      </p>
    </div>

    <ol class="mt-10 grid gap-5 md:grid-cols-2">
      <li class="rounded-2xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-happy text-lg font-bold text-slate-900"
            >1</span
          >
          <h3 class="font-display text-xl font-bold text-white">Say hello</h3>
        </div>
        <p class="mt-4 text-slate-100">
          Email <strong class="text-happy">{links.email.display}</strong> or
          <a
            href={links.whatsappCommunity.href}
            rel="noopener"
            target="_blank"
            class="underline hover:text-happy">join our WhatsApp community</a
          >
          and tell us you&rsquo;d like to visit. We&rsquo;ll be expecting you.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a
            href={links.email.href}
            class="btn-primary bg-white !text-maroon hover:bg-happy hover:!text-slate-900"
          >
            Email us
          </a>
          <a
            href={links.whatsappCommunity.href}
            rel="noopener"
            target="_blank"
            class="btn-whatsapp"
          >
            WhatsApp community
          </a>
        </div>
      </li>

      <li class="rounded-2xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-happy text-lg font-bold text-slate-900"
            >2</span
          >
          <h3 class="font-display text-xl font-bold text-white">Come along on a Monday</h3>
        </div>
        <p class="mt-4 text-slate-100">
          We meet <strong class="text-happy">every Monday</strong> at
          {meeting.startTimeLabel}, {meeting.venueName}, {meeting.room}. When you arrive, ask for
          the <strong class="text-happy">current VP of Membership</strong> or the
          <strong class="text-happy">Club President</strong>. Totally free, totally no-pressure.
        </p>
      </li>
    </ol>
  </div>
</section>
