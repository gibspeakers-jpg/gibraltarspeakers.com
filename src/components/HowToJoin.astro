---
import { links, meeting } from "../data/site";
---

<section id="how-to-join" class="section bg-maroon text-white">
  <div class="container mx-auto max-w-5xl">
    <div class="max-w-2xl">
      <p class="section-eyebrow text-happy">How to join</p>
      <h2 class="section-heading text-white">Two small steps.</h2>
      <p class="mt-4 text-lg text-slate-100">
        No forms to print. No hoops to jump through. No commitment before your first visit.
      </p>
    </div>

    <ol class="mt-10 grid gap-5 md:grid-cols-2">
      <li class="rounded-2xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-happy text-lg font-bold text-slate-900"
            >1</span
          >
          <h3 class="font-display text-xl font-bold text-white">Email us</h3>
        </div>
        <p class="mt-4 text-slate-100">
          Drop a note to <strong class="text-happy">{links.email.display}</strong> and tell us you&rsquo;d
          like to visit. We&rsquo;ll confirm the next date, time, and room so you are expected.
        </p>
        <a
          href={links.email.href}
          class="btn-primary mt-5 bg-white !text-maroon hover:bg-happy hover:!text-slate-900"
        >
          Email GibSpeakers@gmail.com
        </a>
      </li>

      <li class="rounded-2xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-happy text-lg font-bold text-slate-900"
            >2</span
          >
          <h3 class="font-display text-xl font-bold text-white">Come along on a meeting Monday</h3>
        </div>
        <p class="mt-4 text-slate-100">
          We meet on the <strong class="text-happy">{meeting.cadence}</strong>. When you arrive, ask
          for the <strong class="text-happy">current VP of Membership</strong> or the
          <strong class="text-happy">Club President</strong>. They will walk you through the short
          application and answer anything you want to know. Totally free, totally no-pressure.
        </p>
      </li>
    </ol>

    <p class="mt-8 text-sm text-slate-200">
      Prefer LinkedIn first?
      <a
        href={links.linkedin.href}
        rel="noopener"
        target="_blank"
        class="underline hover:text-happy">Send us a message there</a
      >
      — introduce yourself; we love knowing who&rsquo;s new.
    </p>
  </div>
</section>
