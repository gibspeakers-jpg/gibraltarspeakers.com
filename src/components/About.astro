---
import { Image } from "astro:assets";
import rock from "../assets/images/gibraltar-rock.jpg";
import logo from "../assets/images/club-logo.png";
import tmLogo from "../assets/images/toastmasters-logo@2x.png";
import { club } from "../data/site";

const charteredLabel = new Date(club.chartered).toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
});
---

<section id="about" class="section bg-[--color-paper]">
  <div class="container mx-auto max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="section-eyebrow">About the club</p>
        <h2 class="section-heading">Gibraltar&rsquo;s Toastmasters club.</h2>
        <p class="mt-4 text-lg text-slate-600">
          We chartered as <strong>{club.officialName}</strong> — club number {club.clubNumber} — in {
            charteredLabel
          }. We are part of District {club.district}, Division {club.division}, Area {club.area}.
        </p>
        <p class="mt-4 text-slate-600">
          After a quieter chapter, we are revitalising the club and inviting new and returning
          members to help build a thriving speaking community on the Rock — welcoming, supportive,
          and practical.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
          <div class="rounded-lg bg-white p-4 shadow-sm">
            <dt class="text-slate-500">Club number</dt>
            <dd class="font-display text-lg font-bold text-slate-900">{club.clubNumber}</dd>
          </div>
          <div class="rounded-lg bg-white p-4 shadow-sm">
            <dt class="text-slate-500">District</dt>
            <dd class="font-display text-lg font-bold text-slate-900">
              {club.district} · Div {club.division} · Area {club.area}
            </dd>
          </div>
        </dl>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <Image
          src={rock}
          alt="Stylised view of the Rock of Gibraltar at dusk"
          widths={[240, 480, 800]}
          sizes="(min-width:1024px) 280px, 50vw"
          class="aspect-[4/5] h-full w-full rounded-2xl object-cover shadow-md"
        />
        <div class="flex flex-col gap-3">
          <div
            class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-white p-6 shadow-md"
          >
            <Image
              src={logo}
              alt="Gibraltar Speakers club logo"
              widths={[160, 240]}
              class="h-24 w-24"
            />
          </div>
          <div
            class="flex aspect-square w-full items-center justify-center rounded-2xl bg-cyan-700/10 p-6 shadow-md"
          >
            <Image
              src={tmLogo}
              alt="Toastmasters International"
              widths={[200, 320]}
              class="h-auto w-full max-w-[200px]"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
