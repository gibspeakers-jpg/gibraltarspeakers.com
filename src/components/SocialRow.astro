---
import { links } from "../data/site";

interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const color =
  variant === "dark" ? "text-white hover:text-happy" : "text-slate-500 hover:text-maroon";
---

<ul class={`flex flex-wrap items-center gap-4 ${color}`}>
  <li>
    <a
      href={links.email.href}
      class="inline-flex items-center gap-2 transition-colors"
      aria-label={links.email.label}
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      <span class="sr-only">Email</span>
    </a>
  </li>
  <li>
    <a
      href={links.linkedin.href}
      class="inline-flex items-center gap-2 transition-colors"
      aria-label={links.linkedin.label}
      rel="noopener"
      target="_blank"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
      <span class="sr-only">LinkedIn</span>
    </a>
  </li>
  {
    links.toastmastersDirectory.available && (
      <li>
        <a
          href={links.toastmastersDirectory.href}
          class="inline-flex items-center gap-2 transition-colors"
          aria-label={links.toastmastersDirectory.label}
          rel="noopener"
          target="_blank"
        >
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
          </svg>
          <span class="sr-only">Toastmasters.org club page</span>
        </a>
      </li>
    )
  }
</ul>
