---
import { Image } from "astro:assets";
import heroImage from "../assets/images/gibraltar-rock.jpg";
import logo from "../assets/images/club-logo.png";
import { club, meeting, links, openHouse } from "../data/site";
---

<section id="top" class="relative isolate overflow-hidden bg-cyan-700 text-white">
  <Image
    src={heroImage}
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    quality={70}
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-cyan-800/85 via-cyan-700/75 to-maroon/70"
  >
  </div>

  <div
    class="container mx-auto flex min-h-[calc(100vh-4rem)] flex-col justify-center py-16 sm:py-20 lg:py-24"
  >
    <div class="max-w-3xl">
      <div
        class="mb-6 inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold backdrop-blur"
      >
        <Image src={logo} alt="" width={36} height={36} class="h-9 w-9 rounded-full bg-white" />
        <span>{club.shortName} Toastmasters &middot; {club.city}</span>
      </div>

      <h1 class="font-display text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">
        Find your voice.<br />
        <span class="text-happy">{club.tagline}.</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg text-slate-100 sm:text-xl">
        Public speaking and leadership practice in a friendly English-speaking club on the Rock. We
        meet <strong class="font-semibold">{meeting.cadence.toLowerCase()}</strong> at
        {meeting.startTimeLabel}.
        <strong class="font-semibold text-happy">Your first visit is always free.</strong>
      </p>

      <p class="mt-3 max-w-2xl text-base text-slate-200/90">
        Open House {openHouse.dateLabel} at GFSB — or join us any Monday evening.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="#open-house" class="btn-primary"> Open House details </a>
        <a
          href={links.email.href}
          class="btn-secondary border-white/40 bg-white/10 text-white hover:bg-white/20"
        >
          Email us to visit
        </a>
        <a href={links.whatsappCommunity.href} rel="noopener" target="_blank" class="btn-whatsapp">
          Join our WhatsApp community
        </a>
      </div>

      <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 text-sm sm:gap-6 sm:text-base">
        <div>
          <dt class="text-slate-300">When</dt>
          <dd class="font-semibold">{meeting.cadence}, {meeting.startTimeLabel}</dd>
        </div>
        <div>
          <dt class="text-slate-300">Where</dt>
          <dd class="font-semibold">{meeting.venueName}</dd>
        </div>
        <div>
          <dt class="text-slate-300">Cost</dt>
          <dd class="font-semibold">Guests — free</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
